DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Jeton d'accès pour l'upload d'images vers Vercel Blob (requis pour le backoffice)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# URL publique du site. Sur Vercel, mettez le domaine AVEC https:// —
# « deluxia.vercel.app » sans protocole ferait planter toutes les pages.
# Si cette variable est absente, Vercel utilise automatiquement l'URL du déploiement.
NEXT_PUBLIC_SITE_URL="https://deluxia.dz"
ADMIN_EMAIL="admin@deluxia.dz"
ADMIN_PASSWORD="changer-ce-mot-de-passe"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
